# ==============================================================================
# Poco Elder Care Platform — Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_2026
POSTGRES_DB=poco_eldercare
POSTGRES_PORT=5432

# Connection string for Prisma ORM & backend API
# (For local dev use localhost:5432; in Docker Compose stack use postgres:5432)
DATABASE_URL="postgresql://postgres:postgres_secure_password_2026@localhost:5432/poco_eldercare?schema=public&connection_limit=10&pool_timeout=15"

# ------------------------------------------------------------------------------
# 2. Server & Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
NODE_OPTIONS="--max-old-space-size=300"
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Secrets (Min 32 characters for production security)
# ------------------------------------------------------------------------------
JWT_SECRET=poco-external-jwt-secret-key-development-2026-min-32-chars
INTERNAL_JWT_SECRET=poco-internal-jwt-secret-key-development-2026-min-32-chars
JWT_EXTERNAL_SECRET=poco-external-jwt-secret-key-development-2026-min-32-chars
JWT_INTERNAL_SECRET=poco-internal-jwt-secret-key-development-2026-min-32-chars
JWT_REFRESH_SECRET=poco-refresh-jwt-secret-key-development-2026-min-32-chars

# ------------------------------------------------------------------------------
# 4. AI Triage & Classification Keys
# ------------------------------------------------------------------------------
# Anthropic Claude 3.5 Sonnet/Haiku for async activity feed classification
ANTHROPIC_API_KEY=sk-ant-api03-sample-anthropic-key-change-me
# Optional OpenAI fallback
OPENAI_API_KEY=sk-sample-openai-key-optional

# ------------------------------------------------------------------------------
# 5. Integration Partner Webhooks & HMAC Signatures
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
SWIGGY_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
ONE_MG_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
APOLLO_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
PORTEA_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
DR_LAL_PATH_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
METROPOLIS_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
HEALTHIANS_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
MAX_HEALTH_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
MANIPAL_HEALTH_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
FORTIS_HEALTH_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
MEDICAB_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
EMERGENCY_AMBULANCE_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026
KINDRED_TELEHEALTH_WEBHOOK_SECRET=poco_mock_webhook_secret_key_2026

# ------------------------------------------------------------------------------
# 6. S3 / DigitalOcean Spaces Cloud Storage (Direct Presigned Uploads)
# ------------------------------------------------------------------------------
AWS_S3_BUCKET=poco-eldercare-media
AWS_ACCESS_KEY_ID=sample_spaces_access_key
AWS_SECRET_ACCESS_KEY=sample_spaces_secret_key
AWS_REGION=blr1
AWS_ENDPOINT=https://blr1.digitaloceanspaces.com

# ------------------------------------------------------------------------------
# 7. Database Seeding & Testing Knobs
# ------------------------------------------------------------------------------
ALLOW_PROD_SEED=false
QUICK_SEED=false
