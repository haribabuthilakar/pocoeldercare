{
  "name": "@poco/api",
  "version": "0.0.0",
  "private": true,
  "description": "Shared NestJS backend REST API and background worker for Poco Elder Care",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "11.0.0",
    "@nestjs/core": "11.0.0",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.0",
    "@nestjs/platform-express": "11.0.0",
    "@poco/business-rules": "workspace:*",
    "@poco/constants": "workspace:*",
    "@poco/database": "workspace:*",
    "@poco/integrations": "workspace:*",
    "@poco/types": "workspace:*",
    "@poco/validation": "workspace:*",
    "@types/bcrypt": "5.0.2",
    "@types/bcryptjs": "2.4.6",
    "@types/passport-jwt": "4.0.1",
    "bcrypt": "5.1.1",
    "bcryptjs": "2.4.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@poco/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
