{
  "name": "@poco/types",
  "version": "0.0.0",
  "description": "Shared TypeScript domain contracts, JWT payloads, and DTO interfaces for Poco Elder Care",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@poco/constants": "workspace:*"
  },
  "devDependencies": {
    "@poco/tsconfig": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
