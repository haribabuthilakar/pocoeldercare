# Multi-stage Dockerfile for Poco Elder Care Field Mobile App (Web Server)
FROM node:22-alpine AS base

RUN apk add --no-cache libc6-compat openssl
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

WORKDIR /app

ENV CI=true
ENV TURBO_CONCURRENCY=1

# Copy root configuration and lockfiles
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Copy packages & targeted app
COPY packages ./packages
COPY apps/field-app ./apps/field-app

# Install monorepo dependencies
RUN pnpm install --frozen-lockfile

# Generate Prisma client and build dependencies with single concurrency
RUN pnpm --filter @poco/database db:generate
RUN pnpm turbo build --filter=@poco/field-app --concurrency=1

# Production runtime stage
FROM node:22-alpine AS runner

RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOST="0.0.0.0"

# Copy full built workspace
COPY --from=base /app ./

EXPOSE 3001

CMD ["node", "apps/field-app/dist/server.js"]
