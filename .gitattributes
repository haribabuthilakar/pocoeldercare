# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Force scripts to use LF line endings
*.sh text eol=lf
*.bash text eol=lf

# Windows batch and powershell files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
