# Multi-stage Dockerfile for Poco Elder Care Admin Operations Portal (Next.js)
FROM node:22-alpine AS base

RUN apk add --no-cache libc6-compat openssl
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

WORKDIR /app

# Copy root manifest files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Copy all packages & apps
COPY packages ./packages
COPY apps/admin-portal ./apps/admin-portal
COPY apps/api ./apps/api
COPY apps/field-app ./apps/field-app

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Generate Prisma Client & build workspace dependencies and Web Portal
RUN pnpm --filter @poco/database db:generate
ENV NEXT_OUTPUT_STANDALONE=true
RUN pnpm --filter @poco/admin-portal build

# Production runtime stage
FROM node:22-alpine AS runner

RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy workspace and build artifacts
COPY --from=base /app ./

EXPOSE 3000

CMD ["pnpm", "--filter", "@poco/admin-portal", "start"]
