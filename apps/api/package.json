{
  "name": "@poco/api",
  "version": "0.0.0",
  "private": true,
  "description": "Shared NestJS backend REST API and background worker for Poco Elder Care",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
