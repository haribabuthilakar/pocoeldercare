{
  "name": "@poco/admin-portal",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js Admin Operations Portal for Poco Elder Care",
  "scripts": {
    "build": "tsup && next build",
    "build:tsup": "tsup",
    "build:next": "next build",
    "start": "next start -p 3000",
    "dev": "next dev -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .next"
  },
  "dependencies": {
    "@poco/business-rules": "workspace:*",
    "@poco/constants": "workspace:*",
    "@poco/database": "workspace:*",
    "@poco/design-tokens": "workspace:*",
    "@poco/integrations": "workspace:*",
    "@poco/types": "workspace:*",
    "@poco/ui": "workspace:*",
    "@poco/validation": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@poco/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
