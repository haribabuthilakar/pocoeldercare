{
  "name": "poco-elder-care",
  "version": "0.0.0",
  "private": true,
  "description": "Poco Elder Care Operations & Technology Platform",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @poco/database db:migrate",
    "db:seed": "pnpm --filter @poco/database db:seed",
    "db:seed:quick": "pnpm --filter @poco/database db:seed:quick",
    "db:seed:realistic": "pnpm --filter @poco/database db:seed:realistic"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
