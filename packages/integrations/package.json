{
  "name": "@poco/integrations",
  "version": "0.0.0",
  "description": "Integration partner stubs, mock adapters, dynamic fault injection, and webhook dispatcher for Poco Elder Care",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@poco/business-rules": "workspace:*",
    "@poco/constants": "workspace:*",
    "@poco/database": "workspace:*",
    "@poco/types": "workspace:*",
    "@poco/validation": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@poco/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
