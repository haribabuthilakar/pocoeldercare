# Multi-stage Dockerfile for Poco Elder Care Admin Operations Portal (Next.js)
FROM node:22-alpine AS base

RUN apk add --no-cache libc6-compat openssl
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

WORKDIR /app

ENV CI=true
ENV NEXT_TELEMETRY_DISABLED=1
ENV TURBO_CONCURRENCY=1

# Copy root configuration and lockfiles
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Copy packages & targeted app
COPY packages ./packages
COPY apps/admin-portal ./apps/admin-portal

# Install monorepo dependencies
RUN pnpm install --frozen-lockfile

# Generate Prisma client and build dependencies with single concurrency
RUN pnpm --filter @poco/database db:generate
RUN pnpm turbo build --filter=@poco/admin-portal --concurrency=1

# Production runtime stage
FROM node:22-alpine AS runner

RUN apk add --no-cache libc6-compat openssl
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy full built workspace
COPY --from=base /app ./

EXPOSE 3000

CMD ["pnpm", "--filter", "@poco/admin-portal", "start"]
